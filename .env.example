# Copy to .env in the repository root for Docker Compose. Replace placeholders.
# Use URL-safe characters in MYSQL_PASSWORD so it can also appear in DATABASE_URL.
MYSQL_DATABASE=bizledger_db
MYSQL_USER=bizledger
MYSQL_PASSWORD=replace_with_url_safe_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
MYSQL_PORT=3307

# Keep development mode when accessing the local HTTP stack; cookies are then
# usable over HTTP. Set production only behind HTTPS/TLS termination.
NODE_ENV=development
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
DATABASE_URL=mysql://bizledger:replace_with_url_safe_database_password@mysql:3306/bizledger_db
JWT_SECRET=replace_with_a_long_random_secret

# Optional; only needed when running the admin seed command.
ADMIN_EMAIL=local-admin@example.invalid
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_NAME=Local BizLedger Admin
