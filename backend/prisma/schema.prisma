generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum SalesOrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED

  @@map("sales_order_status")
}

enum InvoiceType {
  PURCHASE
  SALES

  @@map("invoice_type")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE

  @@map("invoice_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER

  @@map("payment_method")
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  SALE_FULFILLMENT
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT

  @@map("inventory_transaction_type")
}


model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  description     String?  @db.Text
  sku             String   @unique @db.VarChar(60)
  unit            String   @db.VarChar(30)
  specifications  String?  @db.Text
  purchasePrice   Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice    Decimal  @map("selling_price") @db.Decimal(12, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  stockQuantity   Decimal  @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minStockLevel   Decimal  @default(0) @map("min_stock_level") @db.Decimal(12, 3)
  remarks         String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  categoryId      Int?     @map("category_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([categoryId])
  @@map("products")
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  inventoryTransactions InventoryTransaction[]
}

model Supplier {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(150)
  companyName    String?       @map("company_name") @db.VarChar(150)
  email          String?       @db.VarChar(150)
  phone          String?       @db.VarChar(20)
  address        String?       @db.Text
  taxRegistration String?      @map("tax_registration") @db.VarChar(50)
  paymentTerms   String?       @map("payment_terms") @db.VarChar(100)
  status         PartnerStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([name])
  @@map("suppliers")
  purchaseOrders PurchaseOrder[]
}

model Buyer {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(150)
  companyName     String?       @map("company_name") @db.VarChar(150)
  email           String?       @db.VarChar(150)
  phone           String?       @db.VarChar(20)
  billingAddress  String?       @map("billing_address") @db.Text
  shippingAddress String?       @map("shipping_address") @db.Text
  taxRegistration String?       @map("tax_registration") @db.VarChar(50)
  status          PartnerStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([name])
  @@map("buyers")
  salesOrders SalesOrder[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
model PurchaseOrder {
  id                  Int                 @id @default(autoincrement())
  orderNumber         String              @unique @map("order_number") @db.VarChar(50)
  supplierId          Int                 @map("supplier_id")
  status              PurchaseOrderStatus @default(DRAFT)
  orderDate           DateTime            @default(now()) @map("order_date")
  expectedDelivery    DateTime?           @map("expected_delivery")
  subtotal            Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal             @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal            Decimal             @default(0) @map("tax_total") @db.Decimal(12, 2)
  additionalCharges   Decimal             @default(0) @map("additional_charges") @db.Decimal(12, 2)
  totalAmount         Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  remarks             String?             @db.Text
  deliveryInstructions String?            @map("delivery_instructions") @db.Text
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  items               PurchaseOrderItem[]
  invoice             Invoice?

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int           @map("purchase_order_id")
  productId         Int           @map("product_id")
  productName       String        @map("product_name") @db.VarChar(255)
  sku               String        @db.VarChar(100)
  orderedQuantity   Decimal       @map("ordered_quantity") @db.Decimal(12, 3)
  receivedQuantity  Decimal       @default(0) @map("received_quantity") @db.Decimal(12, 3)
  unitPrice         Decimal       @map("unit_price") @db.Decimal(12, 2)
  discountPercent   Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate           Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal         Decimal       @map("line_total") @db.Decimal(12, 2)

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model SalesOrder {
  id                    Int             @id @default(autoincrement())
  orderNumber           String          @unique @map("order_number") @db.VarChar(50)
  buyerId               Int             @map("buyer_id")
  status                SalesOrderStatus @default(NEW)
  orderDate             DateTime        @default(now()) @map("order_date")
  deliveryDate          DateTime?       @map("delivery_date")
  subtotal              Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal         Decimal         @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal              Decimal         @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingCharges       Decimal         @default(0) @map("shipping_charges") @db.Decimal(12, 2)
  totalAmount           Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  remarks               String?         @db.Text
  deliveryInstructions  String?         @map("delivery_instructions") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  buyer                 Buyer           @relation(fields: [buyerId], references: [id])
  items                 SalesOrderItem[]
  invoice               Invoice?

  @@index([buyerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              Int        @id @default(autoincrement())
  salesOrderId    Int        @map("sales_order_id")
  productId       Int        @map("product_id")
  productName     String     @map("product_name") @db.VarChar(255)
  sku             String     @db.VarChar(100)
  quantity        Decimal    @db.Decimal(12, 3)
  unitPrice       Decimal    @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal    @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal    @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal       Decimal    @map("line_total") @db.Decimal(12, 2)

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model Invoice {
  id                Int           @id @default(autoincrement())
  invoiceNumber     String        @unique @map("invoice_number") @db.VarChar(50)
  type              InvoiceType
  status            InvoiceStatus @default(UNPAID)
  purchaseOrderId   Int?          @unique @map("purchase_order_id")
  salesOrderId      Int?          @unique @map("sales_order_id")
  invoiceDate       DateTime      @default(now()) @map("invoice_date")
  dueDate           DateTime?     @map("due_date")
  subtotal          Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  additionalCharges Decimal       @default(0) @map("additional_charges") @db.Decimal(12, 2)
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrder        SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]

  @@index([type, status])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id              Int      @id @default(autoincrement())
  invoiceId       Int      @map("invoice_id")
  productName     String   @map("product_name") @db.VarChar(255)
  sku             String   @db.VarChar(100)
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                Int           @id @default(autoincrement())
  invoiceId         Int           @map("invoice_id")
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime      @default(now()) @map("payment_date")
  method            PaymentMethod
  transactionReference String?    @map("transaction_reference") @db.VarChar(150)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")

  invoice           Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}
model InventoryTransaction {
  id              Int                     @id @default(autoincrement())
  productId       Int                     @map("product_id")
  type            InventoryTransactionType
  quantityChange  Decimal                 @map("quantity_change") @db.Decimal(12, 3)
  referenceType   String?                 @map("reference_type") @db.VarChar(50)
  referenceId     Int?                    @map("reference_id")
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")

  product         Product                 @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}