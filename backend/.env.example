# ─────────────────────────────────────────────────────────────
# BizLedger Backend – Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── Database (used by Prisma CLI via DATABASE_URL) ──────────
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME"

# ── Database (used at runtime by the MariaDB adapter) ───────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bizledger_db

# ── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_secret_here

# ── Admin seed (optional – defaults shown) ──────────────────
ADMIN_EMAIL=admin@bizledger.com
# Set a unique password with at least 12 characters before running npm run seed.
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_NAME=BizLedger Admin
